# Korvo App SDK defaults
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# PSRAM (required for WiFi stability on Korvo)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# ESP32 Rev3 + PSRAM: INT WDT must be enabled, but don't check CPU1
# (model loading blocks both cores during PSRAM cache operations)
CONFIG_ESP_INT_WDT_TIMEOUT_MS=10000
# CONFIG_ESP_INT_WDT_CHECK_CPU1 is not set
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y

# Board configuration for ESP32-Korvo v1.1 with ES7210/ES8311 codec
CONFIG_ESP32_KORVO_V1_1_BOARD=y

# Bluetooth LE scanning support for realtime device discovery
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_AVRCP_ENABLED=y
# CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED is not set
# CONFIG_BT_GOEPC_ENABLED is not set
# CONFIG_BT_GATTS_ENABLE is not set
# CONFIG_BT_GATTC_ENABLE is not set

# Reduce IRAM footprint for ESP32 + BT/WiFi coexistence builds
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_ESP_GDBSTUB_ENABLED is not set
# CONFIG_ESP_GDBSTUB_SUPPORT_TASKS is not set
# CONFIG_ESP_SYSTEM_GDBSTUB_RUNTIME is not set
# CONFIG_BT_BLE_SMP_ENABLE is not set
# CONFIG_BT_BLE_SMP_BOND_NVS_FLASH is not set
# CONFIG_BT_SMP_ENABLE is not set
CONFIG_BT_ACL_CONNECTIONS=1
# CONFIG_BT_MULTI_CONNECTION_ENBALE is not set
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=1
# CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM is not set
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
# CONFIG_SPI_SLAVE_ISR_IN_IRAM is not set
# CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR is not set
# CONFIG_ESP_SPI_BUS_LOCK_ISR_FUNCS_IN_IRAM is not set
# CONFIG_ESP_PHY_IRAM_OPT is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
